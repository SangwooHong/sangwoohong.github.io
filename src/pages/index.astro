---
import BaseLayout from "../layouts/BaseLayout.astro";
import CurrentResearchCard from "../components/CurrentResearchCard.astro";
import Hero from "../components/Hero.astro";
import JoinBanner from "../components/JoinBanner.astro";
import NewsList from "../components/NewsList.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { homeCurrentResearch } from "../data/currentResearch";
import { featuredPublications } from "../data/publications";
---

<BaseLayout>
  <Hero />

  <section class="section muted">
    <div class="container">
      <SectionTitle eyebrow="Featured Publications" title="주요 연구 성과" />
      <div class="feature-grid">
        {featuredPublications.slice(0, 3).map((publication) => (
          <PublicationEntry publication={publication} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle eyebrow="Current Research" title="현재 진행 중인 연구" />
      <div class="current-research-grid current-research-grid-home">
        {homeCurrentResearch.map((item) => (
          <CurrentResearchCard item={item} variant="home" />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <SectionTitle eyebrow="Latest News" title="Recent Updates" />
      <NewsList limit={5} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <JoinBanner />
    </div>
  </section>
</BaseLayout>
