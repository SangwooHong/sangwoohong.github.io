---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import JoinBanner from "../components/JoinBanner.astro";
import NewsList from "../components/NewsList.astro";
import PublicationEntry from "../components/PublicationEntry.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { people } from "../data/people";
import { featuredPublications, publications } from "../data/publications";
import { getProjectsWithStatus } from "../data/projects";

const members = [...people.pi, ...people.graduate, ...people.undergraduate, ...people.alumni];
const activeProjects = getProjectsWithStatus().filter((project) => project.status === "Ongoing");
---

<BaseLayout>
  <Hero />

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Featured Research"
        title="Reliability Across the AI Stack"
        description="Representative work across Foundation Models, Reliable & Safe AI Algorithms, and the Physical World."
      />
      <div class="feature-grid">
        {featuredPublications.slice(0, 3).map((publication) => (
          <PublicationEntry publication={publication} />
        ))}
      </div>
    </div>
  </section>

  <section class="section muted">
    <div class="container two-column">
      <div>
        <SectionTitle eyebrow="Latest News" title="Recent Updates" />
        <NewsList limit={5} />
      </div>
      <aside class="glance">
        <p class="eyebrow">TML at a Glance</p>
        <div class="stat"><strong>{members.length}</strong><span>Members</span></div>
        <div class="stat"><strong>{publications.length}</strong><span>Publications</span></div>
        <div class="stat"><strong>{activeProjects.length}</strong><span>Active Projects</span></div>
        <div class="stat"><strong>8 x NVIDIA B200</strong><span>Research Computing</span></div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <JoinBanner />
    </div>
  </section>
</BaseLayout>
