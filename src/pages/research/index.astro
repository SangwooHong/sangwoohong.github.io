---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResearchStackFigure from "../../components/ResearchStackFigure.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import RepresentativePaper from "../../components/RepresentativePaper.astro";
import { crossCutting, researchAreas } from "../../data/research";
import { getRepresentativePublications } from "../../data/publications";
---

<BaseLayout title="Research">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">Research</p>
      <h1>Reliable AI from foundations to deployment.</h1>
      <p>
        TML studies reliability from computational foundations, through foundation
        models, to AI systems operating in the physical world. Reliable &amp; Safe
        AI Algorithms connect all three levels.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ResearchStackFigure variant="detailed" />
    </div>
  </section>

  <section class="section muted">
    <div class="container">
      <SectionTitle title="Research Areas" />
      <div class="area-grid">
        {researchAreas.map((area) => (
          <article class="area-card research-area-card">
            <h2>{area.title}</h2>
            <p>{area.summary}</p>
            <ul class="topic-list">
              {area.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <div class="representative-papers">
              <h3>Representative Papers</h3>
              {getRepresentativePublications(area.title).map((publication) => (
                <RepresentativePaper publication={publication} />
              ))}
            </div>
          </article>
        ))}
        <article class="area-card cross research-area-card">
          <h2>{crossCutting.title}</h2>
          <p>{crossCutting.summary}</p>
          <ul class="topic-list">
            {crossCutting.topics.map((topic) => <li>{topic}</li>)}
          </ul>
          <div class="representative-papers">
            <h3>Representative Papers</h3>
            {getRepresentativePublications(crossCutting.title).map((publication) => (
              <RepresentativePaper publication={publication} />
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
