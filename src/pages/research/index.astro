---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CurrentResearchCard from "../../components/CurrentResearchCard.astro";
import ResearchStackFigure from "../../components/ResearchStackFigure.astro";
import RepresentativePaper from "../../components/RepresentativePaper.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { currentResearch, getCurrentResearchByAlgorithm } from "../../data/currentResearch";
import { getPublicationsByAlgorithm, getRepresentativePublications, type Publication } from "../../data/publications";
import { reliabilityProblems, researchAreas } from "../../data/research";

const uniquePublications = (publications: Publication[]) =>
  publications.filter((publication, index, list) => list.findIndex((item) => item.id === publication.id) === index);

const problemId = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<BaseLayout title="Research">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">Research</p>
      <h1>Reliable AI from foundations to deployment.</h1>
      <p lang="ko">
        TML은 계산 기반부터 Foundation Models, 실제 Physical World까지 AI의 신뢰성을 연구합니다.
        Reliable &amp; Safe AI Algorithms는 이 세 계층을 가로질러 연결합니다.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ResearchStackFigure variant="detailed" />
    </div>
  </section>

  <section class="section muted">
    <div class="container">
      <SectionTitle
        eyebrow="Current Research"
        title="Current Research Directions"
        description="Active research directions currently pursued at TML."
      />
      <div class="current-research-grid current-research-grid-all">
        {currentResearch.map((item) => (
          <CurrentResearchCard item={item} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle
        eyebrow="Research by Layer"
        title="Research Across the AI Stack"
        description="Research themes and representative publications organized by system layer."
      />
      <div class="area-grid research-layer-grid">
        {researchAreas.map((area) => (
          <article class="area-card research-area-card" data-layer={area.title}>
            <figure class="research-area-figure">
              <img src={area.visualImage} alt={area.visualAlt} loading="lazy" />
            </figure>
            <h2>{area.title}</h2>
            <p class="area-korean" lang="ko">{area.koreanSummary}</p>
            <p>{area.summary}</p>
            <ul class="topic-list">
              {area.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <div class="representative-papers">
              <h3>Representative Papers</h3>
              {getRepresentativePublications(area.title).slice(0, 3).map((publication) => (
                <RepresentativePaper publication={publication} />
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section reliability-problems-section">
    <div class="container">
      <SectionTitle
        eyebrow="Research by Reliability Problem"
        title="Reliable & Safe AI Algorithms"
        description="Cross-layer research organized by the reliability problem being addressed."
      />
      <div class="reliability-problem-list">
        {reliabilityProblems.map((problem) => {
          const relatedResearch = problem.tags.flatMap((tag) => getCurrentResearchByAlgorithm(tag)).filter((item, index, list) => list.findIndex((candidate) => candidate.id === item.id) === index);
          const relatedPublications = uniquePublications(problem.tags.flatMap((tag) => getPublicationsByAlgorithm(tag)));

          return (
            <article class="reliability-problem" id={problemId(problem.title)}>
              <header>
                <p class="eyebrow">Cross-Layer Problem</p>
                <h2>{problem.title}</h2>
                <p lang="ko">{problem.koreanQuestion}</p>
              </header>
              <div class="reliability-problem-content">
                {relatedResearch.length > 0 && (
                  <div class="problem-current-research">
                    <h3>Current Research</h3>
                    <ul>
                      {relatedResearch.map((item) => (
                        <li><a href={`#current-${item.id}`}>{item.title}</a></li>
                      ))}
                    </ul>
                  </div>
                )}
                {relatedPublications.length > 0 && (
                  <div class="problem-publications">
                    <h3>Selected Publications</h3>
                    {relatedPublications.slice(0, 4).map((publication) => (
                      <RepresentativePaper publication={publication} />
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
