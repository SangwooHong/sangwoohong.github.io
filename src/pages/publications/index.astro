---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublicationEntry from "../../components/PublicationEntry.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { publications, type ReliabilityProblem, type ResearchLayer } from "../../data/publications";

const years = [...new Set(publications.map((pub) => pub.year))].sort((a, b) => b - a);
const layers: ResearchLayer[] = ["Reliable Computing", "Foundation Models", "Physical World"];
const problems: ReliabilityProblem[] = ["Unlearning", "Privacy", "Robustness", "Alignment", "Explainability"];
---

<BaseLayout title="Publications">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">Publications</p>
      <h1>Publication Archive</h1>
      <p>Selected and recent papers from TML and Prof. Sangwoo Hong.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionTitle title="Research Taxonomy" description="Publications organized by AI stack layer and, when applicable, a cross-layer reliability problem." />
      <div class="publication-taxonomy">
        <div>
          <h2>Layer</h2>
          <div class="tag-row large">
            {layers.map((layer) => <span>{layer}</span>)}
          </div>
        </div>
        <div>
          <h2>Reliability Problem</h2>
          <div class="tag-row large">
            {problems.map((problem) => <span>{problem}</span>)}
          </div>
        </div>
      </div>
      <div class="year-list">
        {years.map((year) => (
          <section class="year-section">
            <h2>{year}</h2>
            <div class="publication-list">
              {publications.filter((pub) => pub.year === year).map((publication) => (
                <PublicationEntry publication={publication} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
