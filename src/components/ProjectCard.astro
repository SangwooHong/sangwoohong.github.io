---
interface Props {
  project: {
    title: string;
    status: string;
    agency: string;
    duration: string;
    themes: string[];
    description: string;
  };
}
const project = Astro.props.project;
---

<article class="project-card">
  <div class="project-topline">
    <span>{project.status}</span>
    <span>{project.duration}</span>
  </div>
  <h3>{project.title}</h3>
  <p class="agency">{project.agency}</p>
  <p>{project.description}</p>
  <div class="tag-row">
    {project.themes.map((theme) => <span>{theme}</span>)}
  </div>
</article>
