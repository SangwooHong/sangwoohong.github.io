---
import { formatProjectDuration, type ProjectWithStatus } from "../data/projects";

interface Props {
  project: ProjectWithStatus;
}
const project = Astro.props.project;
---

<article class="project-card">
  <div class="project-topline">
    <span class:list={["project-status", project.status.toLowerCase()]}>{project.status}</span>
    <span>{formatProjectDuration(project)}</span>
  </div>
  <h3>{project.title}</h3>
  {project.originalTitle && <p class="original-title">{project.originalTitle}</p>}
  <p class="agency">{project.agency}</p>
  <p>{project.description}</p>
  <div class="tag-row">
    {project.themes.map((theme) => <span>{theme}</span>)}
  </div>
</article>
