---
import type { Publication } from "../data/publications";

interface Props {
  publication: Publication;
}
const publication = Astro.props.publication;
---

<article class="publication-entry">
  <img src={publication.image} alt={`Teaser figure for ${publication.title}`} loading="lazy" />
  <div>
    <div class="publication-meta">
      <span>{publication.venueShort}</span>
      <span>{publication.layer}</span>
      {publication.algorithmTags?.map((tag) => <span>{tag}</span>)}
    </div>
    <h3>{publication.title}</h3>
    <p class="authors">{publication.authors}</p>
    <p>{publication.venue}, {publication.year}</p>
    <div class="entry-links">
      {publication.links?.paper && <a href={publication.links.paper}>Paper</a>}
      {publication.links?.code && <a href={publication.links.code}>Code</a>}
      {publication.links?.project && <a href={publication.links.project}>Project</a>}
      {publication.note && <span>{publication.note}</span>}
    </div>
  </div>
</article>
