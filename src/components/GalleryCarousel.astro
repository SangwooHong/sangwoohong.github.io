---
import type { GalleryItem } from "../data/gallery";

interface Props {
  items: GalleryItem[];
  label: string;
}

const { items, label } = Astro.props;
---

<div class="gallery-carousel" data-gallery-carousel>
  <div class="gallery-carousel-stage" aria-live="polite">
    {items.map((item, index) => (
      <figure class="gallery-slide" data-gallery-slide hidden={index !== 0}>
        <div class="gallery-slide-media">
          <img src={item.src} alt={item.alt} loading={index === 0 ? "eager" : "lazy"} />
        </div>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))}
  </div>
  <div class="gallery-carousel-controls">
    <button class="gallery-carousel-button" type="button" data-gallery-previous aria-label="Previous photo">←</button>
    <span class="gallery-carousel-count" data-gallery-count aria-label={`${items.length} photos`}>1 / {items.length}</span>
    <button class="gallery-carousel-button" type="button" data-gallery-next aria-label="Next photo">→</button>
  </div>
  <div class="gallery-thumbnails" aria-label={label}>
    {items.map((item, index) => (
      <button
        class="gallery-thumbnail"
        type="button"
        data-gallery-thumbnail
        aria-label={`Show photo ${index + 1} of ${items.length}: ${item.caption ?? item.alt}`}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        <img src={item.src} alt="" />
      </button>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const thumbnails = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-gallery-thumbnail]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-gallery-previous]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const count = carousel.querySelector<HTMLElement>("[data-gallery-count]");
    let activeIndex = 0;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== activeIndex;
      });

      thumbnails.forEach((thumbnail, thumbnailIndex) => {
        thumbnail.setAttribute("aria-pressed", String(thumbnailIndex === activeIndex));
      });

      if (count) count.textContent = `${activeIndex + 1} / ${slides.length}`;
      thumbnails[activeIndex]?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
    };

    previous?.addEventListener("click", () => showSlide(activeIndex - 1));
    next?.addEventListener("click", () => showSlide(activeIndex + 1));
    thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener("click", () => showSlide(index)));

    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showSlide(activeIndex - 1);
      if (event.key === "ArrowRight") showSlide(activeIndex + 1);
    });
  });
</script>
