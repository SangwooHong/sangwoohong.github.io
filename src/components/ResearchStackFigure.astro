---
interface Props {
  variant?: "compact" | "detailed";
}

const { variant = "detailed" } = Astro.props;
const loading = variant === "compact" ? "eager" : "lazy";
---

<figure class:list={["stack-figure", "research-logo-figure", `research-logo-figure-${variant}`]}>
  <img
    class="research-logo-image"
    src="/assets/img/brand/Research_Logo.png"
    alt="TML research framework connecting Reliable Computing, Foundation Models, and Physical World with Reliable and Safe AI Algorithms."
    loading={loading}
    decoding="async"
  />
</figure>
