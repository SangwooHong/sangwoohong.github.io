---
import type { Publication } from "../data/publications";

interface Props {
  publication: Publication;
}

const publication = Astro.props.publication;
---

{publication.links?.paper ? (
  <a href={publication.links.paper} class="paper-link">
    <span class="paper-link-meta">{`${publication.venueShort} · ${publication.year}`}</span>
    <br />
    <strong class="paper-link-title">{publication.title}</strong>
  </a>
) : (
  <div class="paper-link paper-link-static">
    <span class="paper-link-meta">{`${publication.venueShort} · ${publication.year}`}</span>
    <br />
    <strong class="paper-link-title">{publication.title}</strong>
  </div>
)}
